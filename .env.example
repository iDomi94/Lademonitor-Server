# In .env kopieren und anpassen, um die Postgres-Zugangsdaten des
# docker-compose-Stacks zu ueberschreiben (Standardwerte greifen sonst, siehe
# docker-compose.yml). Die Postgres-Instanz ist nur intern im Compose-Netzwerk
# erreichbar, nicht nach aussen exponiert - fuer den Heimnetz-Betrieb ist der
# Default unkritisch, kann aber trotzdem ueberschrieben werden.
POSTGRES_USER=charging
POSTGRES_PASSWORD=charging
POSTGRES_DB=charging

# Optional: Schluessel fuer die Feld-Verschluesselung (GPS-Koordinaten,
# Notizen - siehe backend/app/crypto.py und CLAUDE.md, Abschnitt
# "Verschluesselung personenbezogener Daten"). Leer lassen = App laeuft wie
# bisher unverschluesselt (voellig ausreichend fuers eigene Heimnetz).
# Empfohlen, sobald der Server oeffentlich erreichbar ist (z.B. eigener
# Reverse Proxy). Erzeugen mit:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Einmal gesetzt und benutzt NICHT mehr entfernen (siehe crypto.py) - sicher
# verwahren (z.B. Passwort-Manager) und NICHT im /config-Datenverzeichnis
# ablegen, sonst landet er im selben Backup wie die damit verschluesselten
# Daten und der Schutz waere wirkungslos.
FIELD_ENCRYPTION_KEY=
